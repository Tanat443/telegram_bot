# Telegram
TELEGRAM_BOT_TOKEN=replace_with_new_botfather_token
TELEGRAM_CHANNEL_USERNAME=@test_tanat
TELEGRAM_WEBHOOK_SECRET=change-this-telegram-webhook-secret

# HTTP server
PORT=3000
PUBLIC_BASE_URL=https://your-public-domain.example
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-long-random-session-secret
LESSON_VIDEO_URL=https://example.com/lesson.mp4
LESSON_VIDEO_POSTER_URL=https://example.com/lesson-cover.jpg

# Meta / Instagram
META_VERIFY_TOKEN=change-this-verify-token
META_ACCESS_TOKEN=replace_with_meta_page_or_ig_token
META_API_VERSION=v24.0
META_GRAPH_BASE_URL=https://graph.instagram.com

# Optional: use this when you know the bot username and want fixed IG button links.
# If empty, the app asks Telegram for the bot username on startup.
TELEGRAM_BOT_USERNAME=

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/instagram_telegram_gate?retryWrites=true&w=majority
MONGODB_DB=instagram_telegram_gate
